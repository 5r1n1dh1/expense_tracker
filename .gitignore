# --- Gradle / Android ---
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class

# --- Signing material — NEVER commit (P8) ---
# The release keystore lives only in a GitHub secret.
keystore.properties
*.jks
*.keystore
google-services.json.dummy

# --- Firebase ---
# D3: google-services.json IS committed (it is not a secret — access is gated by
# package name + signing SHA). This pattern catches accidental copies elsewhere.
**/google-services.json.bak
serviceAccountKey*.json
*-firebase-adminsdk-*.json

# --- Firebase Emulator (rules tests) ---
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# --- Local tooling ---
node_modules/
.idea/workspace.xml
captures/
.externalNativeBuild/
.hugo_build.lock
site/

# --- Test / coverage output ---
/coverage/
/reports/
*.lcov

