# Central pinned SHAs for third-party GitHub Actions (P8 — supply-chain hardening).
#
# Why SHA pinning: `uses: action@v4` is a MOVING TARGET. Anyone who publishes a
# tag can change what runs in this repo, with access to your source, your CI and
# your secrets. A 40-char commit SHA is immutable.
#
# Dependabot (.github/dependabot.yml) keeps these current automatically — it opens
# PRs to bump the SHA when a new tag is published. Never loosen these back to tags.

SHARED_KEYWORDS: &pin
  actions/checkout: 11d5960a326750d5838078e36cf38b85af677262 # v4
  actions/setup-java: cf277c60eb25467037889841efdb72551f06f6c3 # v4
  actions/setup-node: 49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
  actions/upload-artifact: ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
  actions/attest-build-provenance: ef244123eb79f2f7a7e75d99086184180e6d0018 # v1
  gradle/actions/setup-gradle: 48b5f213c81028ace310571dc5ec0fbbca0b2947 # v4
  android-actions/setup-android: 9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3
  reactivecircus/android-emulator-runner: a421e43855164a8197daf9d8d40fe71c6996bb0d # v2
  softprops/action-gh-release: 3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2
  google-github-actions/auth: c200f3691d83b41bf9bbd8638997a462592937ed # v2
  google-github-actions/setup-gcloud: e427ad8a34f8676edf47cf7d7925499adf3eb74f # v2