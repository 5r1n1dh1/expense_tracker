<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firestore sync requires network. P1: the app makes no other outbound calls
         except the optional, user-initiated update check (§18.8). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Glance widget (D7/screen requirement). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KharchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Kharch.Starting">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kharch.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget entry: the translucent quick-add activity (§10).
             Launched only via explicit intent from the Glance widget /
             self PendingIntent, so it must NOT be exported. Exported +
             no intent-filter triggered One UI 9 / API 31+ ExportedActivity
             handling and an empty taskAffinity broke the back stack. -->
        <activity
            android:name=".widget.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.Kharch.Translucent" />

        <!-- Glance widget receiver. Without this the widget can never be
             placed and GlanceAppWidget.updateAll() drops updates. -->
        <receiver
            android:name=".widget.GlanceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kharch_widget_info" />
        </receiver>

        <!-- WorkManager is initialised via KharchApp (Configuration.Provider)
             with HiltWorkerFactory, not via the default initializer. The
             provider below removes the default initializer so androidx.startup
             does not initialise WorkManager twice (Android 15/16 throws if
             it tries). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>