<?xml version="1.0" encoding="utf-8"?>
<!-- Brand gradient fallback backdrop (§8.2). A low-res source is all the frosted
     backdrop needs, since it is downsampled to ~1/16 anyway. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/brand_indigo"
        android:endColor="@color/brand_teal"
        android:type="linear" />
</shape>